# PR Review Agent — required environment variables
#
# For local testing only. In production, these are set as GitHub repo secrets.
# Never commit a real .env file — it's in .gitignore.

# Composio — handles GitHub API + auth
COMPOSIO_API_KEY=

# OpenAI — the LLM behind the agent (uses gpt-4o-mini by default)
OPENAI_API_KEY=

# Target repo to review (only needed for local runs)
GITHUB_REPO=owner/repo
PR_NUMBER=1
